# Локальная конфигурация: скопируйте этот файл в .env. Файл .env игнорируется Git.
# Непустые значения из окружения имеют приоритет над .env.
DEEPSEEK_API_KEY=

# Отдельный файл состояния для диагностического запуска; по умолчанию .local/agent-history.json.
AGENT_HISTORY_FILE=

# MCP для личного Яндекс Диска. Создайте OAuth-приложение с доступом к Диску
# и сохраните токен только в локальном .env (файл уже исключён из Git).
YANDEX_DISK_OAUTH_TOKEN=
YANDEX_DISK_ROOT=AI Challenge

# По умолчанию MCP ищет видео на Рабочем столе текущего пользователя.
# Для другой папки укажите абсолютный путь.
VIDEO_SOURCE_DIR=

# GitHub MCP. Чтение публичного репозитория работает без токена. Для создания
# или обновления текста укажите fine-grained token с Contents: Read and write.
GITHUB_REPOSITORY=Desuzed/ai-challenge-app
GITHUB_TOKEN=

# Локальная Ollama на Mac (по умолчанию http://127.0.0.1:11434).
OLLAMA_URL=
# Отдельный сервер Ollama на Windows. Например http://<WINDOWS_PC_IP>:11434.
# Если адрес не задан, источник «Удалённые» выключен.
REMOTE_OLLAMA_URL=
